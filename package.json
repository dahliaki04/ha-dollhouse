{
  "name": "ha-dollhouse",
  "version": "0.4.2",
  "description": "Home Assistant card: draw rooms in seconds, drag entities onto a 2D/3D floor plan",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:site": "vite build --config vite.site.config.ts",
    "deploy:site": "npm run build:site && wrangler pages deploy site-dist --project-name ha-dollhouse --commit-dirty=true"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.170.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.170.0"
  }
}